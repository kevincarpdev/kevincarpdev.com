# ---- copy to .env and fill in. NEVER commit .env ----

# Secret for signing session cookies. Generate: openssl rand -hex 32
SECRET_KEY=change-me

# ---- LLM provider: fill in ONE of the two options ----
# Option A (active if LLM_API_KEY set): any OpenAI-compatible API.
# A1 — Nous inference API key (Hermes models only; sk-nous-...):
#      LLM_BASE_URL=https://inference-api.nousresearch.com/v1
# A2 — Nous Portal SUBSCRIPTION via `hermes proxy start --host 0.0.0.0`
#      (full proxied catalog incl. Claude/GPT; key can be any string):
#      LLM_BASE_URL=http://host.docker.internal:8645/v1
# Discover valid model ids:  curl <base>/models -H "Authorization: Bearer <key>"
LLM_BASE_URL=https://inference-api.nousresearch.com/v1
LLM_API_KEY=
LLM_MODEL=Hermes-4-405B

# Option B: Anthropic (platform.claude.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Honcho managed API (app.honcho.dev)
HONCHO_API_KEY=
# Fresh workspace = clean memory. Changing this value is how you "reset" Honcho.
HONCHO_WORKSPACE_ID=kc-hq-v1

# Optional: domain for HTTPS via Caddy (leave empty to serve on http://<vps-ip>)
DOMAIN=

# SQLite location (inside container volume)
DATABASE_URL=sqlite:////data/hq.db

# ---- Phase 2 integrations (leave empty until wired) ----
SLACK_BOT_TOKEN=
ASANA_PAT=
GMAIL_CREDENTIALS_JSON=
GITHUB_TOKEN=
