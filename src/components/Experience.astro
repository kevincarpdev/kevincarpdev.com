<style>
  /* ── Pillar switcher ─────────────────────────────────── */
  .pillars {
    margin-top: clamp(40px, 6vw, 72px);
    display: grid;
    gap: clamp(28px, 4vw, 48px);
  }

  /* ── Tab strip (mobile: horizontal scroller) ─────────── */
  .pillars__tabs {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding: 4px 4px 12px;
    margin: 0 calc(var(--gutter) * -1);
    padding-left: var(--gutter);
    padding-right: var(--gutter);
    scrollbar-width: thin;
    scrollbar-color: var(--line-2) transparent;
  }
  .pillars__tabs::-webkit-scrollbar { height: 6px; }
  .pillars__tabs::-webkit-scrollbar-thumb { background: var(--line-2); border-radius: 999px; }
  .pillars__tabs::-webkit-scrollbar-track { background: transparent; }

  .pillars__tab {
    flex: 0 0 auto;
    scroll-snap-align: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    border: 1px solid var(--line);
    background: var(--bg-2);
    color: var(--text-2);
    border-radius: var(--radius-pill);
    transition: border-color .2s, color .2s, background .2s, box-shadow .2s, transform .2s;
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
  }
  .pillars__tab:hover {
    color: var(--text);
    border-color: var(--line-2);
  }
  .pillars__tab:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .pillars__tab.is-active {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 10px 30px -12px var(--accent-glow);
  }
  .pillars__tab-code {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--text-3);
  }
  .pillars__tab.is-active .pillars__tab-code { color: rgba(13, 17, 23, 0.65); }
  .pillars__tab-name { font-weight: 600; }
  .pillars__tab-count {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-3);
    border: 1px solid var(--line);
  }
  .pillars__tab.is-active .pillars__tab-count {
    background: rgba(13, 17, 23, 0.18);
    color: rgba(13, 17, 23, 0.85);
    border-color: rgba(13, 17, 23, 0.18);
  }

  /* ── Panels ─────────────────────────────────────────── */
  .pillars__panel[hidden] { display: none; }

  .pillars__panel-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 18px;
    margin-bottom: 28px;
    border-bottom: 1px solid var(--line);
  }
  .pillars__panel-eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .pillars__panel-eyebrow span { color: var(--accent); }
  .pillars__panel-meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-3);
  }

  /* ── Grid of project cards (mobile-first) ─────────────── */
  .pillars__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 640px) {
    .pillars__grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
  }
  @media (min-width: 1024px) {
    .pillars__grid { grid-template-columns: repeat(3, 1fr); gap: 22px; }
  }

  .pcard {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(18px, 2.4vw, 24px);
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color .2s, transform .2s, box-shadow .2s, background .2s;
    min-width: 0;
  }
  .pcard:hover {
    border-color: var(--accent);
    background: var(--bg-3);
    box-shadow: 0 18px 40px -22px var(--accent-glow);
    transform: translateY(-2px);
  }
  .pcard__client {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .pcard__client strong {
    font-size: 16px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.01em;
    word-break: break-word;
  }
  .pcard__client span {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--text-3);
    letter-spacing: 0.02em;
    word-break: break-word;
  }
  .pcard__stack {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--accent-glow);
    padding: 6px 10px;
    border-radius: 6px;
    align-self: flex-start;
    line-height: 1.5;
    max-width: 100%;
    word-break: break-word;
  }
  .pcard__impact {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-2);
  }

  /* ── Reduced motion ──────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .pillars__tab,
    .pcard { transition: none; }
    .pcard:hover { transform: none; }
  }
</style>

<script>
  // Pillar tab switcher — accessible, no deps
  const root = document.querySelector<HTMLElement>('[data-pillars]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.pillars__tab'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.pillars__panel'));

    const activate = (pillar: string, focus = false) => {
      tabs.forEach((tab) => {
        const isActive = tab.dataset.pillar === pillar;
        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        tab.tabIndex = isActive ? 0 : -1;
        if (isActive && focus) tab.focus();
      });
      panels.forEach((panel) => {
        const isActive = panel.id === `pillar-${pillar}`;
        if (isActive) panel.removeAttribute('hidden');
        else panel.setAttribute('hidden', '');
      });
    };

    tabs.forEach((tab, idx) => {
      tab.addEventListener('click', () => {
        const pillar = tab.dataset.pillar;
        if (pillar) activate(pillar);
      });
      tab.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft' && e.key !== 'Home' && e.key !== 'End') return;
        e.preventDefault();
        let next = idx;
        if (e.key === 'ArrowRight') next = (idx + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') next = (idx - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        const pillar = tabs[next].dataset.pillar;
        if (pillar) activate(pillar, true);
      });
    });
  }
</script>
