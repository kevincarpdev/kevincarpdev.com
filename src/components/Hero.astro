---
// Hero section — extracted from legacy index.html on 2026-05-20
---
<!-- ═══════════ HERO ═══════════ -->
<section class="hero">
  <div class="container hero__inner">
    <div class="hero__left">
      <div class="hero__status" role="status" aria-label="Availability status">
        <div class="hero__status-led">
          <span class="hero__status-led-dot" aria-hidden="true"></span>
          <span class="hero__status-led-ring" aria-hidden="true"></span>
        </div>
        <div class="hero__status-body">
          <div class="hero__status-row">
            <span class="hero__status-k">STATUS</span>
            <span class="hero__status-v">Available</span>
          </div>
          <div class="hero__status-row">
            <span class="hero__status-k">CYCLE</span>
            <span class="hero__status-v">2026 · Q1 — Q3</span>
          </div>
          <div class="hero__status-row">
            <span class="hero__status-k">SLOTS</span>
            <span class="hero__status-v">02 <small>open</small></span>
          </div>
        </div>
        <div class="hero__status-sigil" aria-hidden="true">KCD<br/>—26</div>
      </div>

      <h1 class="hero__title">
        <span class="line">Senior Full-Stack</span>
        <span class="line"><span class="accent">Architect</span><span class="dot">.</span></span>
      </h1>

      <p class="hero__role"><b>Headless commerce</b> · <b>Regulated systems</b> · <b>Enterprise integrations</b></p>

      <p class="hero__sub">
        I design and ship the infrastructure behind high-stakes digital products — React and Next.js storefronts, NetSuite middleware, compliance-heavy platforms, and performance-sensitive web experiences. I help teams connect the front end to the operational backbone without building something fragile.
      </p>

      <div class="hero__ctas">
        <a class="btn btn--primary btn--lg" href="#work">View Selected Work <span class="arrow">→</span></a>
        <a class="btn btn--lg" href="assets/files/Kevin%20Resume.docx" download>Download Resume ↓</a>
      </div>

      <div class="hero__meta" role="list">
        <div class="hero__meta-cell" role="listitem">
          <div class="hero__meta-k">Experience</div>
          <div class="hero__meta-v">14<small>+ yrs</small></div>
        </div>
        <div class="hero__meta-cell" role="listitem">
          <div class="hero__meta-k">Projects</div>
          <div class="hero__meta-v">120<small>+</small></div>
        </div>
        <div class="hero__meta-cell" role="listitem">
          <div class="hero__meta-k">Retention</div>
          <div class="hero__meta-v">100<small>%</small></div>
        </div>
      </div>
    </div>

    <div class="hero__portrait" aria-hidden="true">
      <span class="hero__portrait-arrow hero__portrait-arrow--l">&lt;</span>
      <span class="hero__portrait-arrow hero__portrait-arrow--r">&gt;</span>
      <div class="hero__portrait-img"></div>
    </div>
  </div>
</section>
