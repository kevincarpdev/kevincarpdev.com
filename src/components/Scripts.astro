---
// Inline behavior: nav scroll state, mobile drawer, stack filter, reveal-on-scroll.
---
<script is:inline>
// ── NAV scroll state + mobile drawer ─────────────────────────
  (function () {
    const nav = document.getElementById('nav');
    const burger = nav?.querySelector('.nav__burger');
    const drawer = document.getElementById('nav-drawer');
    const drawerLinks = drawer?.querySelectorAll('.nav__drawer-link, .nav__drawer-cta a');

    function setScrolled() {
      if (window.scrollY > 12) nav.classList.add('is-scrolled');
      else nav.classList.remove('is-scrolled');
    }
    setScrolled();
    window.addEventListener('scroll', setScrolled, { passive: true });

    function setDrawer(open) {
      if (!nav) return;
      nav.dataset.open = open ? 'true' : 'false';
      burger?.setAttribute('aria-expanded', open ? 'true' : 'false');
      // toggle drawer visibility via CSS sibling selector — also handle directly:
      if (drawer) drawer.style.transform = open ? 'translateY(0)' : 'translateY(-100%)';
      document.body.style.overflow = open ? 'hidden' : '';
    }
    burger?.addEventListener('click', () => setDrawer(nav.dataset.open !== 'true'));
    drawerLinks?.forEach(a => a.addEventListener('click', () => setDrawer(false)));
    window.addEventListener('resize', () => { if (window.innerWidth > 880) setDrawer(false); });
  })();

  // ── Scroll-spy: highlight the nav link of the section in view ──
  (function () {
    const links = Array.from(document.querySelectorAll('.nav__link[data-section], .nav__drawer-link[data-section]'));
    if (!links.length) return;

    const groups = new Map();
    links.forEach(link => {
      const id = link.dataset.section;
      const sec = document.getElementById(id);
      if (!sec) return;
      if (!groups.has(id)) groups.set(id, { el: sec, links: [] });
      groups.get(id).links.push(link);
    });
    if (!groups.size) return;

    const navEl = document.getElementById('nav');
    function navHeight() {
      return navEl ? navEl.getBoundingClientRect().height : 64;
    }

    function update() {
      const probe = window.scrollY + navHeight() + 24;
      let activeId = null;
      groups.forEach(({ el }, id) => {
        const top = el.offsetTop;
        const bottom = top + el.offsetHeight;
        if (probe >= top && probe < bottom) activeId = id;
      });
      // If we're below the last tracked section, keep it active
      if (!activeId) {
        const ids = Array.from(groups.keys());
        const lastId = ids[ids.length - 1];
        const lastTop = groups.get(lastId).el.offsetTop;
        if (probe >= lastTop) activeId = lastId;
      }
      groups.forEach(({ links }, id) => {
        const on = id === activeId;
        links.forEach(l => l.classList.toggle('is-active', on));
      });
    }

    let raf = 0;
    function schedule() {
      if (raf) return;
      raf = requestAnimationFrame(() => { raf = 0; update(); });
    }
    update();
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
  })();

  // ── Stack filter pills ───────────────────────────────────────
  (function () {
    const filters = document.querySelectorAll('.stack-filter');
    const items   = document.querySelectorAll('#matrix .matrix__item');
    filters.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.filter;
        filters.forEach(f => {
          f.classList.toggle('is-active', f === btn);
          f.setAttribute('aria-selected', f === btn ? 'true' : 'false');
        });
        items.forEach(it => {
          const match = cat === 'all' || it.dataset.cat === cat;
          it.classList.toggle('is-dim', !match);
        });
      });
    });
  })();

  // ── Pillar deck (tabs + mobile carousel sync) ────────────────
  (function () {
    const deck = document.querySelector('.pillars-deck');
    if (!deck) return;
    const cards = Array.from(deck.querySelectorAll('.pillar-card'));
    const dots  = Array.from(document.querySelectorAll('.pillars-dots .pillars-dot'));
    if (!cards.length) return;

    function activate(idx, opts = {}) {
      cards.forEach((c, i) => {
        const active = i === idx;
        c.classList.toggle('is-active', active);
        c.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      dots.forEach((d, i) => d.classList.toggle('is-active', i === idx));

      // On mobile (carousel mode), scroll the chosen card into view.
      if (opts.scroll && window.matchMedia('(max-width: 720px)').matches) {
        cards[idx].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }
    }

    // Click / focus to activate (desktop tablist behavior)
    cards.forEach((card, idx) => {
      card.addEventListener('click', () => activate(idx, { scroll: true }));
      card.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          const next = (idx + 1) % cards.length;
          cards[next].focus();
          activate(next, { scroll: true });
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          const prev = (idx - 1 + cards.length) % cards.length;
          cards[prev].focus();
          activate(prev, { scroll: true });
        }
      });
    });

    // Dot tap → activate
    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => activate(idx, { scroll: true }));
    });

    // On mobile, sync dots with scroll position via IntersectionObserver
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (!window.matchMedia('(max-width: 720px)').matches) return;
        entries.forEach((entry) => {
          if (entry.isIntersecting && entry.intersectionRatio > 0.6) {
            const idx = cards.indexOf(entry.target);
            if (idx >= 0) activate(idx);
          }
        });
      }, { root: deck, threshold: [0.6] });
      cards.forEach(c => io.observe(c));
    }

    // Auto-rotate on desktop, but pause on hover/focus (subtle ambience)
    let autoTimer = null;
    function startAuto() {
      if (window.matchMedia('(max-width: 720px)').matches) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      stopAuto();
      autoTimer = setInterval(() => {
        const currentIdx = cards.findIndex(c => c.classList.contains('is-active'));
        const next = (currentIdx + 1) % cards.length;
        activate(next);
      }, 5500);
    }
    function stopAuto() { if (autoTimer) { clearInterval(autoTimer); autoTimer = null; } }
    deck.addEventListener('mouseenter', stopAuto);
    deck.addEventListener('mouseleave', startAuto);
    deck.addEventListener('focusin', stopAuto);
    deck.addEventListener('focusout', startAuto);
    // Kick off after the section is in view
    if ('IntersectionObserver' in window) {
      const sectionIO = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) { startAuto(); }
          else { stopAuto(); }
        });
      }, { threshold: 0.25 });
      sectionIO.observe(deck);
    }
  })();

  // ── Reveal on scroll ─────────────────────────────────────────
  (function () {
    const items = document.querySelectorAll('.reveal');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !('IntersectionObserver' in window)) {
      items.forEach(el => el.classList.add('is-visible'));
      return;
    }
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8%' });
    items.forEach(el => io.observe(el));
    // safety: reveal after 1.4s no matter what
    setTimeout(() => items.forEach(el => el.classList.add('is-visible')), 1400);
  })();
</script>
